{
  "name": "dubai-legal",
  "version": "0.1.0",
  "private": true,
  "description": "Legal Dash \u2014 verified directory of lawyers and legal firms",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "prisma generate && next build",
    "start": "next start -p 3100",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:verify": "tsx scripts/verify-db.ts",
    "grant:reviewer": "tsx scripts/grant-reviewer.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "e2e": "tsx scripts/e2e.ts && tsx scripts/e2e-cases.ts && tsx scripts/e2e-admin.ts && tsx scripts/e2e-roles.ts && tsx scripts/e2e-features.ts && tsx scripts/e2e-collab.ts && tsx scripts/e2e-flows.ts && tsx scripts/e2e-brand.ts && tsx scripts/e2e-round2.ts && tsx scripts/e2e-community.ts",
    "e2e:account": "tsx scripts/e2e.ts",
    "e2e:cases": "tsx scripts/e2e-cases.ts",
    "e2e:admin": "tsx scripts/e2e-admin.ts",
    "e2e:roles": "tsx scripts/e2e-roles.ts",
    "e2e:features": "tsx scripts/e2e-features.ts",
    "e2e:collab": "tsx scripts/e2e-collab.ts",
    "e2e:flows": "tsx scripts/e2e-flows.ts",
    "shots": "tsx scripts/shots.ts",
    "e2e:brand": "tsx scripts/e2e-brand.ts",
    "e2e:round2": "tsx scripts/e2e-round2.ts",
    "db:check": "tsx scripts/db-check.ts",
    "e2e:community": "tsx scripts/e2e-community.ts",
    "ux:check": "tsx scripts/ux-check.ts",
    "cf:build": "prisma generate && opennextjs-cloudflare build",
    "cf:preview": "prisma generate && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "prisma generate && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "https": "tsx scripts/https-proxy.ts",
    "call:check": "tsx scripts/call-check.ts",
    "geo:build": "tsx scripts/build-geo-data.ts",
    "geo:backfill": "tsx scripts/backfill-geo.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.16.2",
    "next": "^15.5.0",
    "otplib": "^12.0.1",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.18.1",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/web-push": "^3.6.4",
    "prisma": "^6.16.2",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "wrangler": "^4.136.3"
  }
}
