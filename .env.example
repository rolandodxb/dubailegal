# ─── Legal Dash — local development environment ───────────────────────────────
# Local development only. No production credential belongs in this file.

NODE_ENV=development

# Dedicated local Postgres container (dubailegal-postgres on host port 5433).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public

# Public base URL of this app.
APP_URL=http://localhost:3100

# Session cookie name.
SESSION_COOKIE_NAME=dl_session

# Where uploaded identity documents are written. Kept outside .next and never
# served statically; access always goes through /api/documents/[id].
UPLOAD_DIR=var/uploads

# Password reset / email confirmation tokens.
TOKEN_TTL_MINUTES=60

# Email delivery provider. "outbox" means: no SMTP is configured, so outbound
# email is recorded in a database-backed outbox that a reviewer can read at
# /admin/outbox. Nothing is ever reported to a user as "sent" when it is not.
EMAIL_PROVIDER=outbox
EMAIL_FROM_ADDRESS=no-reply@dubai-legal.local

# Email confirmation is OFF while no mail provider is configured, so new accounts
# are usable immediately. Set to true once a real transport exists.
REQUIRE_EMAIL_VERIFICATION=false

# Comma-separated emails. On signup these accounts are granted the REVIEWER role
# so the very first reviewer can be created without a pre-existing admin.
BOOTSTRAP_REVIEWER_EMAILS=you@example.com

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=replace-with-a-long-random-value-at-least-32-chars

# Browser push notifications. The public key is handed to the browser when
# somebody turns notifications on; the private key signs each message and must
# never be exposed. Generate a pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=generate-with-npx-web-push-generate-vapid-keys
VAPID_PRIVATE_KEY=generate-with-npx-web-push-generate-vapid-keys
VAPID_SUBJECT=mailto:admin@dubai-legal.local

# Optional external video provider. When set, a conference room offers this as a
# fallback if a peer-to-peer call cannot be established.
# A TURN relay, for calls between devices that cannot reach each other directly.
# STUN alone works on one network; a phone on mobile data talking to a laptop
# behind a router needs the relay. Any provider will do (coturn, Twilio,
# Cloudflare Calls, Metered); leave empty and calls fall back to STUN only.
# Connections opened eagerly at startup and pinged so the pooler keeps them. Keep
# well below the session pooler's client cap, which also covers the test suites.
DB_WARM_CONNECTIONS=4

TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

VIDEO_PROVIDER_URL=

# Encryption at rest for uploaded files and case message bodies.
# Generate one with: openssl rand -base64 32
# Required in production. Losing it means losing every stored file and message.
ENCRYPTION_KEY=

# Supabase: the direct connection (port 5432), used only for migrations.
# Leave it equal to DATABASE_URL on a local Postgres.
#
# DATABASE_URL is the pooled connection — the transaction pooler on port 6543:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# DIRECT_URL is the direct connection, or the session pooler if your host has no
# IPv6 (Supabase's direct connection is IPv6-only for new projects):
#   postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
# Apply the schema with `npx prisma migrate deploy`, then `npm run db:check`.
DIRECT_URL=

# ── Supabase ─────────────────────────────────────────────────────────────────
# The project URL, from Project settings → API.
#
# The publishable key is a browser key: it is safe to ship, and it grants
# nothing on its own because row level security is what decides what a browser
# may read. This application does not use it — every table is reached through
# Prisma on the server — so it is here for a future Storage or Realtime feature
# rather than for the data layer.
SUPABASE_URL=https://zfjhudomfgypcghgylea.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# The database. Two URLs, because migrations and the application need different
# kinds of connection (see the README). Fill in the database password from
# Project settings → Database, then replace DATABASE_URL and DIRECT_URL above
# with these and run `npx prisma migrate deploy && npm run db:check`.
#
# The direct host (db.zfjhudomfgypcghgylea.supabase.co) is IPv6-only on this
# project, so the session pooler is used for migrations instead — it is IPv4 and
# speaks the same protocol on port 5432.
#
# DATABASE_URL="postgresql://postgres.zfjhudomfgypcghgylea:<PASSWORD>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.zfjhudomfgypcghgylea:<PASSWORD>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# ── Local HTTPS ──────────────────────────────────────────────────────────────
# The camera, the microphone and installing the app all require a secure context:
# https:// or http://localhost. That is why a video call works on this machine and
# fails at a network address such as http://192.168.1.85:3100. `npm run https`
# terminates TLS in front of the app on port 3443 with a certificate naming the
# LAN address, so phones and tablets get a secure origin.
HTTPS_PORT=3443
TLS_CERT=var/tls/cert.pem
TLS_KEY=var/tls/key.pem
