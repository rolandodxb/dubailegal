# ─── Dubai Legal — local development environment ───────────────────────────────
# Local development only. No production credential belongs in this file.

NODE_ENV=development

# Dedicated local Postgres container (dubailegal-postgres on host port 5433).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public

# Public base URL of this app.
APP_URL=http://localhost:3100

# Session cookie name.
SESSION_COOKIE_NAME=dl_session

# Where uploaded identity documents are written. Kept outside .next and never
# served statically; access always goes through /api/documents/[id].
UPLOAD_DIR=var/uploads

# Password reset / email confirmation tokens.
TOKEN_TTL_MINUTES=60

# Email delivery provider. "outbox" means: no SMTP is configured, so outbound
# email is recorded in a database-backed outbox that a reviewer can read at
# /admin/outbox. Nothing is ever reported to a user as "sent" when it is not.
EMAIL_PROVIDER=outbox
EMAIL_FROM_ADDRESS=no-reply@dubai-legal.local

# Email confirmation is OFF while no mail provider is configured, so new accounts
# are usable immediately. Set to true once a real transport exists.
REQUIRE_EMAIL_VERIFICATION=false

# Comma-separated emails. On signup these accounts are granted the REVIEWER role
# so the very first reviewer can be created without a pre-existing admin.
BOOTSTRAP_REVIEWER_EMAILS=you@example.com

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=replace-with-a-long-random-value-at-least-32-chars

# Browser push notifications. The public key is handed to the browser when
# somebody turns notifications on; the private key signs each message and must
# never be exposed. Generate a pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=generate-with-npx-web-push-generate-vapid-keys
VAPID_PRIVATE_KEY=generate-with-npx-web-push-generate-vapid-keys
VAPID_SUBJECT=mailto:admin@dubai-legal.local

# Optional external video provider. When set, a conference room offers this as a
# fallback if a peer-to-peer call cannot be established.
VIDEO_PROVIDER_URL=

# Encryption at rest for uploaded files and case message bodies.
# Generate one with: openssl rand -base64 32
# Required in production. Losing it means losing every stored file and message.
ENCRYPTION_KEY=

# Supabase: the direct connection (port 5432), used only for migrations.
# Leave it equal to DATABASE_URL on a local Postgres.
#
# DATABASE_URL is the pooled connection — the transaction pooler on port 6543:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# DIRECT_URL is the direct connection, or the session pooler if your host has no
# IPv6 (Supabase's direct connection is IPv6-only for new projects):
#   postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
# Apply the schema with `npx prisma migrate deploy`, then `npm run db:check`.
DIRECT_URL=
